{
  "name": "wacli-reader",
  "private": true,
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "wacli-reader": "bash -lc 'pnpm --silent build >/dev/null && exec ./dist/wacli-reader \"$@\"' _",
    "build": "mkdir -p dist && CGO_ENABLED=1 CGO_CFLAGS=\"${CGO_CFLAGS:+$CGO_CFLAGS }-Wno-error=missing-braces\" go build -tags sqlite_fts5 -o dist/wacli-reader ./cmd/wacli",
    "start": "pnpm --silent build && ./dist/wacli-reader",
    "test": "pnpm --silent test:go && pnpm --silent test:fts",
    "test:go": "go test ./...",
    "test:fts": "go test -tags sqlite_fts5 ./...",
    "lint": "go vet ./...",
    "format": "gofmt -w .",
    "format:check": "bash -lc 'out=$(gofmt -l .); if [ -n \"$out\" ]; then echo \"$out\"; exit 1; fi'",
    "generate:sqlc": "go run github.com/sqlc-dev/sqlc/cmd/sqlc@v1.31.1 generate"
  },
  "engines": {
    "node": ">=24"
  }
}
